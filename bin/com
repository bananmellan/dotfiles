#!/usr/bin/env python3
import atexit
import os
import readline
import serial
import sys
import threading
import time
import json

baudrate = 115200

if len(sys.argv) > 1:
    port = sys.argv[1]
else:
    print("Please specify a serial port as a command line argument.")
    sys.exit(1)

cmd = None

if len(sys.argv) == 3:
    baudrate = int(sys.argv[2])
elif len(sys.argv) > 3:
    cmd = " ".join(sys.argv[2:])

ser = serial.Serial(port, baudrate, timeout=0.2)

history_file = os.environ.get("HOME") + "/.cache/_com_history"

try:
    readline.read_history_file(history_file)
except FileNotFoundError:
    print(f"No history file found at {history_file}. Starting fresh.")

def read_serial_lines():
    line = ""

    while True:
        char = ser.read()
        try:
            line = line + char.decode()
        except:
            pass

        if len(line) > 0 and line[-1] == '\n':
            print(line, end="")
            line = ""


if cmd is not None:
    ser.write((cmd.strip() + "\r\n").encode())
    for line in ser.readlines():
        print(line.strip().decode())
    exit()

print(f"""
      >> com <<
   baudrate: {baudrate: <8}

{port}\n""")

threading.Thread(target=read_serial_lines).start()

while True:
    try:
        user_input = input("~> ").strip()
    except:
        break

    # Send command to serial port
    ser.write((user_input + "\r\n").encode())

    time.sleep(0.2)

readline.write_history_file(history_file)

os._exit(0)
