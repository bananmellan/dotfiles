#!/usr/bin/env python3
import glob
import logging
import os
import sys
from datetime import datetime
from pathlib import Path
from typing import List, Optional, Tuple

# Configuration: List of (prefix, format_string, slice_length)
# Add new filename patterns to this list.
TIMESTAMP_PATTERNS: List[Tuple[str, str, int]] = [
    ("IMG", "IMG_%Y%m%d_%H%M%S", 19),
    ("VID", "VID_%Y%m%d_%H%M%S", 19),
    ("PXL", "PXL_%Y%m%d_%H%M%S", 19),
    ("Scr", "Screenshot_%Y%m%d-%H%M%S", 26),
    ("20", "%Y-%m-%d-%H-%M-%S", 19),
]

def setup_logging() -> None:
    logging.basicConfig(level=logging.INFO, format='%(message)s')

def get_timestamp_from_filename(filename: str) -> Optional[float]:
    """
    Parses a timestamp from the filename string based on specific patterns.
    Returns a unix timestamp (float) if successful, otherwise None.
    """
    for prefix, fmt, length in TIMESTAMP_PATTERNS:
        if filename.startswith(prefix):
            try:
                return datetime.strptime(filename[:length], fmt).timestamp()
            except (ValueError, IndexError):
                return None
    return None

def set_file_timestamp(path: Path, timestamp: float) -> bool:
    """Sets the access and modification times of a file."""
    try:
        os.utime(path, (timestamp, timestamp))
        return True
    except OSError as e:
        logging.error("Failed to set time for %s: %s", path, e)
        return False

def main() -> None:
    setup_logging()

    if len(sys.argv) < 2:
        logging.error("Usage: %s <glob_pattern> [override_year]", sys.argv[0])
        sys.exit(1)

    pattern = sys.argv[1]
    override_year_arg = sys.argv[2] if len(sys.argv) > 2 else None

    override_timestamp: Optional[float] = None
    if override_year_arg:
        try:
            dt = datetime.strptime(override_year_arg, "%Y")
            override_timestamp = dt.timestamp()
        except ValueError:
            logging.warning("Invalid year format '%s'. Falling back to filename parsing.", override_year_arg)

    for file_path_str in glob.iglob(pattern):
        path = Path(file_path_str)
        timestamp = override_timestamp

        if timestamp is None:
            timestamp = get_timestamp_from_filename(path.name)

        if timestamp:
            set_file_timestamp(path, timestamp)
        else:
            logging.warning("File %s had a weird format.", path)

if __name__ == "__main__":
    main()
