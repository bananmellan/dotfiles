#!/usr/bin/env fish
# Set build configuration for podg
set -x PODG_BUILD_FILE $HEM/imgs/musik/Containerfile
set -x PODG_BUILD_TARGET bitwig

# Set volumes (name=destination format)
set -x PODG_VOLUMES "musik-.local=.local,musik-.cache=.cache,musik-.config=.config,bitwig-data=Bitwig Studio,bitwig-config=.BitwigStudio"

# Set mapdirs
set -x PODG_MAPDIRS "Hämtningar,Dokument,Musik"

podg \
    --audio \
    --name bitwig \
    --rm \
    localhost/musik:bitwig \
    (if test -n "$argv"
        printf -- %argv
    else
        printf bitwig-studio
    end)
