#!/usr/bin/env fish
# vibe-container.fish — build the Vibe CLI image if missing, then run it with the
# current directory mounted as the workspace.

set -l image_name vibe-cli
set -l build_dir (mktemp -d -t vibe-build.XXXXXX)
set -l config_dir $HEM/volumes/mistral

mkdir -p $config_dir

echo '
FROM docker.io/library/python:3.12-slim
RUN pip install --no-cache-dir mistral-vibe
RUN apt-get update
RUN apt-get install -y git
WORKDIR /workspace
ENTRYPOINT ["vibe"]
' > $build_dir/Containerfile

if not podman image exists $image_name
    echo "Building image $image_name..."
    podman build -t $image_name $build_dir
    or begin
        echo "Image build failed."
        rm -rf $build_dir
        exit 1
    end
end

rm -rf $build_dir

set -l mistral_key (systemd-creds --user decrypt $HOME/.secrets/mistral)

podman run -it --rm \
    -v $PWD:/workspace:z \
    -v $config_dir:/root/.vibe:Z \
    -e HOST_PWD=$PWD \
    -e MISTRAL_API_KEY=$mistral_key \
    --security-opt label=disable \
    -w /workspace \
    $image_name
