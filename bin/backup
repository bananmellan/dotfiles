#!/usr/bin/env python3
"""
backup.py — personal backup script.

Runs on boeka (Pixel, Termux). Everything is mirrored to bikupa
(boeka@bikupa). The script is intentionally modular: the himla modes that
were removed for now (mega/storj/proton/adb) can be re-added by extending
the modes section.

Usage:
    python backup.py --android [-v | --verbose] [-n | --dry-run] [-h | --help]
"""

import argparse
import os
import re
import shutil
import subprocess
import sys
from datetime import datetime
from pathlib import Path

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

# bikupa
SRV = "boeka@bikupa"
SRV_BACKUP_ROOT = "/var/lib/backup"
BORG_REPO = f"ssh://{SRV}{SRV_BACKUP_ROOT}/telefon"

# boeka (Termux)
SDCARD = "/sdcard"

# Borg paths
BORG_PATHS = [
    f"{SDCARD}/Backup",
    f"{SDCARD}/Android/media",
    str(Path.home()),
    f"{SDCARD}/.SeedVaultAndroidBackup",
]

# Borg excludes
BORG_EXCLUDES = [
    f"{Path.home()}/.config/borg/security",
    f"{Path.home()}/.cache/borg",
]

# Year-window behavior
GRACE_MONTHS = 1
CATCHUP_IF_WINDOW_MISSED = True
STATE_DIR = str(Path.home() / ".local" / "state" / "backup")

# Runtime flags
verbose = False
dry_run = False

# ---------------------------------------------------------------------------
# Logging helpers
# ---------------------------------------------------------------------------

def log(message: str) -> None:
    """Print informational message."""
    print(f"backup: {message}")

def warn(message: str) -> None:
    """Print warning message to stderr."""
    print(f"backup: warning: {message}", file=sys.stderr)

def die(message: str) -> None:
    """Abort with fatal error message."""
    print(f"backup: fatal: {message}", file=sys.stderr)
    sys.exit(1)

# ---------------------------------------------------------------------------
# Command execution
# ---------------------------------------------------------------------------

def must(args: list[str], **kwargs) -> None:
    """Run command, abort on failure."""
    log(f"running: {' '.join(args)}")
    try:
        subprocess.run(args, check=True, **kwargs)
    except subprocess.CalledProcessError as e:
        die(f"command failed (exit {e.returncode}): {' '.join(args)}")

def must_borg(args: list[str], **kwargs) -> None:
    """Run borg command with special exit code handling."""
    log(f"running: {' '.join(args)}")
    env = os.environ.copy()
    env["BORG_EXIT_CODES"] = "legacy"
    try:
        result = subprocess.run(args, env=env, **kwargs)
        rc = result.returncode

        if rc == 0:
            return
        elif rc == 1:
            warn("borg completed with warnings (exit 1) — operation succeeded, check the log above")
            return
        elif 100 <= rc <= 127:
            warn(f"borg completed with warnings (exit {rc}) — operation succeeded, check the log above")
            return
        else:
            die(f"borg failed (exit {rc}): {' '.join(args)}")
    except Exception as e:
        die(f"borg failed with exception: {e}")

# ---------------------------------------------------------------------------
# Runtime helpers
# ---------------------------------------------------------------------------

def verbose_on() -> bool:
    return verbose

def dry_run_on() -> bool:
    return dry_run

def debug(message: str) -> None:
    if verbose_on():
        log(f"debug: {message}")

def dry_note(message: str) -> None:
    log(f"[dry-run] {message}")

def exclude_args(patterns: list[str]) -> list[str]:
    """Render patterns as rsync --exclude arguments."""
    return [f"--exclude={p}" for p in patterns]

def in_grace_window() -> bool:
    """True during the months right after a year switch."""
    return datetime.now().month <= GRACE_MONTHS

def ensure_gnu_find() -> bool:
    """Verify GNU find (findutils) is available."""
    try:
        result = subprocess.run(["find", "--version"], capture_output=True, text=True)
        return "GNU" in result.stdout
    except Exception:
        warn("GNU find is required (install with: pkg install findutils)")
        return False

# ---------------------------------------------------------------------------
# Server operations
# ---------------------------------------------------------------------------

def srv_sync(src: str, dst: str, excludes: list[str] | None = None) -> None:
    """Mirror CONTENTS of src/ into dst on bikupa (rsync --delete)."""
    rsync_flags = ["-avzp", "--delete"]
    if verbose_on():
        rsync_flags.append("--stats")
    if dry_run_on():
        rsync_flags.append("--dry-run")

    cmd = ["rsync"] + rsync_flags
    if excludes:
        cmd.extend(exclude_args(excludes))
    cmd.extend([f"{src}/", f"{SRV}:{dst}"])

    try:
        result = subprocess.run(cmd, capture_output=True, text=True)
        rc = result.returncode

        if rc == 0:
            return
        elif rc == 24:
            warn("rsync: some files vanished during transfer (exit 24) — treated as success")
            return
        else:
            die(f"rsync failed (exit {rc})")
    except Exception as e:
        die(f"rsync failed with exception: {e}")

def fetch_borg_passphrase() -> None:
    """Fetch Borg passphrase from bikupa via ssh."""
    log(f"fetching Borg passphrase from {SRV}")
    try:
        result = subprocess.run(
            ["ssh", SRV, "systemd-creds", "--user", "decrypt", ".secrets/borg-telefon"],
            capture_output=True, text=True, check=True
        )
        passphrase = result.stdout.strip()
        if not passphrase:
            die(f"could not fetch Borg passphrase from {SRV} (empty output — check ssh and systemd-creds)")
        os.environ["BORG_PASSPHRASE"] = passphrase
    except subprocess.CalledProcessError as e:
        die(f"could not fetch Borg passphrase: {e}")

# ---------------------------------------------------------------------------
# Borg operations
# ---------------------------------------------------------------------------

def borg_backup() -> None:
    """Create Borg archive, prune, and compact."""
    archive_name = f"boeka-{datetime.now():%Y-%m-%d_%H:%M:%S}"

    if dry_run_on():
        log(f"would create Borg archive {BORG_REPO}::{archive_name} of: {' '.join(BORG_PATHS)}")
        log("prune preview (--dry-run)")
        must_borg(["borg", "prune", "--dry-run", "--list", "--keep-weekly", "4", "--keep-monthly", "4", BORG_REPO])
        log(f"would compact {BORG_REPO}")
        return

    log("creating Borg archive")
    create_flags = ["--progress", "--stats", "--lock-wait", "600"]
    if verbose_on():
        create_flags.append("--list")
    for pattern in BORG_EXCLUDES:
        create_flags.extend(["--exclude", pattern])

    must_borg(["borg", "create"] + create_flags + [f"{BORG_REPO}::{archive_name}"] + BORG_PATHS)

    log("pruning")
    must_borg(["borg", "prune", "--list", "--keep-weekly", "4", "--keep-monthly", "4", BORG_REPO])

    log("compacting")
    must_borg(["borg", "compact", BORG_REPO])

# ---------------------------------------------------------------------------
# Media: yearly archive + mirror
# ---------------------------------------------------------------------------

def archive_old_files(curdir: str, arcdir: str) -> None:
    """Move files whose mtime year is not current year into archive dir."""
    year = str(datetime.now().year)
    prev_year = str(datetime.now().year - 1)
    moved_years: set[str] = set()
    moved_count = 0
    tab = '\t'

    v_args = ["-v"] if verbose_on() else []

    # Use GNU find to list files
    try:
        result = subprocess.run(
            ["find", curdir, "-maxdepth", "1", "-type", "f", "-not", "-name", ".*",
             "-printf", f"%TY{tab}%p\\n"],
            capture_output=True, text=True, check=True
        )
        listing = result.stdout.strip().split('\n')
    except subprocess.CalledProcessError as e:
        die(f"find failed on '{curdir}': {e}")

    debug(f"found {len(listing)} file(s) in {curdir}")

    for entry in listing:
        if not entry:
            continue

        parts = entry.split(tab, 1)
        if len(parts) < 2:
            die(f"could not parse find output line: '{entry}' (expected '<year><TAB><path>')")

        file_year, file_path = parts[0], parts[1]

        if not re.match(r'^[0-9]{4}$', file_year):
            die(f"unexpected year '{file_year}' in find output — refusing to archive")

        if file_year == year:
            continue

        if not os.path.exists(file_path):
            warn(f"'{file_path}' vanished during archiving — skipping")
            continue

        target_dir = os.path.join(arcdir, file_year)
        if dry_run_on():
            dry_note(f"would move '{file_path}' -> '{target_dir}/'")
        else:
            if v_args:
                log(f"mkdir -p {target_dir}")
            os.makedirs(target_dir, exist_ok=True)

            if v_args:
                log(f"mv {file_path} {target_dir}/")
            shutil.move(file_path, target_dir)

        moved_count += 1
        moved_years.add(file_year)

    if moved_count > 0:
        years_str = ", ".join(sorted(moved_years))
        action = "would archive" if dry_run_on() else "archived"
        log(f"{action} {moved_count} file(s) from {curdir} into {years_str}")

    for y in sorted(moved_years):
        if y == prev_year:
            if not in_grace_window():
                log(f"note: files from {y} land in the archive after the grace window — "
                    "they only reach bikupa if the last-year catch-up has not run yet")
        else:
            warn(f"files from {y} end up in '{arcdir}/{y}' but will NOT be mirrored "
                 f"(only {prev_year} and {year} are mirrored) — make sure they are covered by the Borg archive")

def sync_previous_year(arcdir: str, trgdir: str, excludes: list[str] | None = None) -> None:
    """Mirror the previous year's bucket."""
    prev_year = str(datetime.now().year - 1)
    archive_path = os.path.join(arcdir, prev_year)

    if not os.path.isdir(archive_path):
        return

    state_file = os.path.join(STATE_DIR, f"prev-year-synced-{os.path.basename(trgdir)}")
    last_synced = None
    if os.path.isfile(state_file):
        with open(state_file, 'r') as f:
            last_synced = f.read().strip()

    debug(f"catch-up state file: {state_file} (last mirrored prev year: '{last_synced}')")

    if in_grace_window():
        log(f"grace window active — mirroring last year ({prev_year}) as well")
    elif last_synced == prev_year:
        return
    elif not CATCHUP_IF_WINDOW_MISSED:
        return
    else:
        log(f"grace window was missed — catching up on last year ({prev_year})")

    rcmd(archive_path, os.path.join(trgdir, prev_year), excludes or [])

    if dry_run_on():
        dry_note(f"would record catch-up state in {state_file}")
    else:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(state_file, 'w') as f:
            f.write(prev_year)

def rcmd(src: str, dst: str, excludes: list[str] | None = None) -> None:
    """Fan-out point for mirrors."""
    if dry_run_on():
        log(f"would mirror {src} -> {SRV}:{dst} (rsync --dry-run)")
    else:
        log(f"mirroring {src} -> {SRV}:{dst}")
    srv_sync(src, dst, excludes)

def media_sync(current_dir: str, archive_dir: str, target_dir: str, excludes: list[str] | None = None) -> int:
    """Orchestrate one media tree: archive old files -> mirror current year -> mirror previous year."""
    year = str(datetime.now().year)

    if not os.path.isdir(current_dir):
        warn(f"'{current_dir}' does not exist — aborting")
        return 1

    if not ensure_gnu_find():
        return 1

    archive_old_files(current_dir, archive_dir)

    log(f"mirroring current year ({year})")
    rcmd(current_dir, os.path.join(target_dir, year), excludes or [])

    sync_previous_year(archive_dir, target_dir, excludes or [])
    return 0

# ---------------------------------------------------------------------------
# Modes
# ---------------------------------------------------------------------------

def android_backup() -> None:
    """Android/Termux backup mode."""
    log("starting android backup")

    fetch_borg_passphrase()
    borg_backup()

    log("mirroring Signal backups")
    rcmd(os.path.join(SDCARD, ".molly"), os.path.join(SRV_BACKUP_ROOT, "telefon-signalbackups"))

    log("syncing camera media")
    media_sync(
        current_dir=os.path.join(SDCARD, "DCIM/Camera"),
        archive_dir=os.path.join(SDCARD, "DCIM"),
        target_dir=os.path.join(SRV_BACKUP_ROOT, "telefon-DCIM"),
        excludes=[".trashed*", ".pending*"]
    )

    log("syncing recordings")
    media_sync(
        current_dir=os.path.join(SDCARD, "Audio Recorder"),
        archive_dir=os.path.join(SDCARD, "Audio Recorder"),
        target_dir=os.path.join(SRV_BACKUP_ROOT, "telefon-inspelningar"),
        excludes=["*/"]
    )

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

def usage() -> None:
    print("usage: backup [--android] [-v | --verbose] [-n | --dry-run] [-h | --help]")
    print()
    print("modes:")
    print("  -a, --android     boeka (Termux): Borg archive + mirrors to bikupa")
    print()
    print("options:")
    print("  -v, --verbose     detailed output (file lists, transfer stats, decisions)")
    print("  -n, --dry-run     preview only — nothing is written on boeka or bikupa")
    print("  -h, --help        show this help and exit")

def main() -> None:
    global verbose, dry_run

    parser = argparse.ArgumentParser(add_help=False)
    parser.add_argument("-a", "--android", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("-v", "--verbose", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("-n", "--dry-run", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("-h", "--help", action="store_true", help=argparse.SUPPRESS)

    args = parser.parse_args()

    if args.help:
        usage()
        sys.exit(0)

    if args.verbose:
        verbose = True
    if args.dry_run:
        dry_run = True

    if not args.android:
        usage()
        die("no mode selected")

    if dry_run_on():
        log("DRY RUN — nothing will be written on boeka or bikupa")

    android_backup()
    log("all done")

if __name__ == "__main__":
    main()
